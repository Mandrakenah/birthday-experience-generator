# ============================================================
# Birthday Experience Generator — environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — NEVER commit real keys.
# ============================================================

# Supabase Project URL  (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key  (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role secret key  (Project Settings → API → service_role)
# SERVER-ONLY. Used exclusively in /api/* route handlers. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used to build shareable links.
# Local: http://localhost:3000   ·   Production: your Vercel/custom-domain URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
